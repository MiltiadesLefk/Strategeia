# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/*
!.vscode/extensions.json
.idea/

# Backend (Python)
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc
backend/.env
backend/runtime/
backend/.pytest_cache/

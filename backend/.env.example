HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173
DB_PATH=runtime/strategeia.db
SETTINGS_PATH=runtime/settings.json

# Every API route requires being logged in (via the dashboard's own login
# screen, POST /api/auth/login) or a real X-API-Key by default — both
# auto-generated into runtime/ on first run if you don't set them yourself
# (see app/config.py's _load_or_create_shared_secret /
# _load_or_create_auth_password). That's the right default for anything
# reachable beyond this machine, but it's friction you don't need for local
# development against `npm run dev` / `uvicorn --reload` on localhost — so
# this file (copied to `.env` for local dev) turns it all back off. Delete
# this line, or set it to `false`, before this backend is ever reachable
# from anywhere but localhost.
ALLOW_UNAUTHENTICATED_API=true

# The dashboard's one login account — there is no signup, no other
# accounts, by design. AUTH_USERNAME defaults to "admin" if left unset;
# AUTH_PASSWORD auto-generates (and logs itself loudly at startup) if left
# unset. Uncomment and set your own to skip that and choose both yourself.
# AUTH_USERNAME=choose-a-username-here
# AUTH_PASSWORD=choose-a-real-password-here
